# Server-local subject archives and formal run outputs are never committed.
subjects/
runs/

# Server-local model binaries are never committed.
runtime/model_assets/*.pth
runtime/model_assets/*.pt
*.mat
*.npz
*.nii
*.nii.gz
*.dcm
*.log
__pycache__/
.pytest_cache/

# Keep metadata and manuals visible to Git.
!runtime/source_records/*.json
!runtime/source_records/*.jsonl
!runtime/source_records/*.txt
